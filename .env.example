# Docker environment defaults for CodeAssist.
# Copied into the build context? No — this file is gitignored and only used by
# `docker compose` for variable substitution. Edit to change ports/workspace.

# Host port that maps to the container's SERVER_PORT (set via config.toml or env).
HOST_PORT=8090

# Port uvicorn listens on inside the container. Overrides [server] port in
# config.toml; the healthcheck targets this same value, so keep them aligned.
SERVER_PORT=8090

# Directory mounted as the container workspace (/workspace). Defaults to the
# project root so shipped skills/tools resolve under codeassist/.
WORKSPACE=.

# Named volume that persists the SQLite DB and session history across recreates.
DATA_VOLUME=codeassist-data

# Container name.
CONTAINER_NAME=codeassist
