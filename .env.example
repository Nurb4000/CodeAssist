# Docker environment defaults for CodeAssist.
# Copied into the build context? No — this file is gitignored and only used by
# `docker compose` for variable substitution. Edit to change ports/workspace.

# Host port that maps to the container's SERVER_PORT (set via config.toml or env).
HOST_PORT=8090

# Port uvicorn listens on inside the container. Overrides [server] port in
# config.toml; the healthcheck targets this same value, so keep them aligned.
SERVER_PORT=8090

# Directory mounted as the container workspace (/workspace). Defaults to the
# project root so shipped skills/tools resolve under codeassist/.
WORKSPACE=.

# Named volume that persists the SQLite DB and session history across recreates.
DATA_VOLUME=codeassist-data

# Host directory for GitHub CLI / git auth config (gh hosts.yml + git credential
# helper). Resolved from each developer's shell at `docker compose` time; no
# home-directory path or credential is baked into the image. Override in a local
# shell or here if you want the auth data somewhere else.
AUTH_DIR=${HOME:-${USERPROFILE}}/.codeassist/auth

# Container name.
CONTAINER_NAME=codeassist

# Remote test VM (optional). test_runner prefers this VM over local execution
# and falls back locally only when it cannot connect. Leave blank to keep the
# values from [remote_test_vm] in config.toml / config.docker.toml; empty env
# vars are deliberately ignored so one config style does not wipe the other.
REMOTE_TEST_VM_ENABLED=
REMOTE_TEST_VM_HOST=
REMOTE_TEST_VM_USER=
REMOTE_TEST_VM_PORT=
REMOTE_TEST_VM_REMOTE_DIR=
REMOTE_TEST_VM_KEY_PATH=
REMOTE_TEST_VM_KNOWN_HOSTS=
REMOTE_TEST_VM_PASSWORD=
REMOTE_TEST_VM_SYNC=
REMOTE_TEST_VM_CONNECT_TIMEOUT=
REMOTE_TEST_VM_TEST_TIMEOUT=
REMOTE_TEST_VM_FALLBACK_TO_LOCAL=
REMOTE_TEST_VM_STRICT_HOST_KEY_CHECKING=
